PORT=3000
# Postgres connection string (Neon, Render, Supabase, local...)
DATABASE_URL=postgres://user:password@localhost:5432/authdb
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Set to "false" only for local Postgres without SSL
DATABASE_SSL=true
